rules_version = '2';

// =============================================================
// FinScore — Firestore Security Rules
// Princípio: nenhum documento é lido/escrito por alguém que não
// seja o dono (uid == request.auth.uid). Aplique isso no console
// do Firebase em Firestore Database > Regras.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function dono(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // /users/{uid}
    match /users/{uid} {
      allow read, write: if dono(uid);
    }

    // /expenses/{expenseId} — documento precisa conter o campo uid
    match /expenses/{expenseId} {
      allow read, update, delete: if autenticado() && resource.data.uid == request.auth.uid;
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
    }

    // /goals/{goalId}
    match /goals/{goalId} {
      allow read, update, delete: if autenticado() && resource.data.uid == request.auth.uid;
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
    }

    // /achievements/{achievementId}
    match /achievements/{achievementId} {
      allow read, update, delete: if autenticado() && resource.data.uid == request.auth.uid;
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
    }

    // /scores/{uid} — id do documento é o próprio uid
    match /scores/{uid} {
      allow read, write: if dono(uid);
    }

    // Qualquer coisa fora do modelo acima é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
